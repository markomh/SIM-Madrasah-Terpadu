# SIM-Madrasah Terpadu — Root .gitignore

# Dependencies
node_modules/
frontend/node_modules/
backend/vendor/

# Next.js
frontend/.next/
frontend/out/
frontend/build/
.next/
out/
build/

# Testing & Coverage
coverage/
frontend/coverage/
backend/coverage/

# Environment Variables
.env
.env.local
.env.production
frontend/.env.local
frontend/.env.production
backend/.env

# PHP & Composer
backend/bootstrap/cache/
backend/storage/*.key
backend/storage/app/
backend/storage/framework/cache/
backend/storage/framework/sessions/
backend/storage/framework/views/
backend/storage/logs/
backend/.phpunit.result.cache

# Logs & Runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.md