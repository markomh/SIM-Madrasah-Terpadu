# SIM Madrasah Terpadu - Frontend Environment Configuration
# Mode Mock (Tahap 1): true | Mode Live API (Tahap 2): false
NEXT_PUBLIC_USE_MOCK=false

# URL REST API Backend (hanya digunakan jika NEXT_PUBLIC_USE_MOCK=false)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Gating portal orang tua (Tahap 4): MUST remain false in all environments
# until the backend entity for orang_tua is fully implemented.
NEXT_PUBLIC_PHASE_4_ENABLED=false
